# API Gateway 环境变量模板
# ── 怎么用 ──
# 1) 本机最简：复制成项目根的 .env 并填入真实 token（根 .env 不覆盖真实环境变量）。
# 2) 交给「网关配置页 → 环境变量」那张卡管理：写 data/.env（权限 600，已进 .gitignore）。
#    那一层用 load_dotenv(override=True) 加载，**故意压过根 .env** ——
#    否则页面里刚改的 Key 会被根 .env 的旧值顶掉。
# 3) 真实环境变量（systemd/supervisor/docker 注入）优先级永远最高，也是生产推荐做法。
# 密钥**不放** yaml：data/gateway.yaml 各供应商用 token_env 引用下面这些变量名。
#
# 第三十轮: 删掉 B_AI_API_KEY（b.ai 供应商早已删除，这个空变量只剩误导）；
#           补上后来实装但一直漏在模板外的 OPENCODE_API_KEY。

AGNES_API_KEY=

OPENCODE_API_KEY=

# 运行参数（可选，覆盖 yaml）
# GATEWAY_CONFIG=/path/to/gateway.yaml
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=8808
# GATEWAY_GRACEFUL_SHUTDOWN=30

# 数据文件路径（可选，默认都在 data/ 下；测试/多实例部署时用得上）
# GATEWAY_USERS=data/users.json
# GATEWAY_HISTORY=data/history.json
# GATEWAY_FEEDBACK=data/feedback.json
# GATEWAY_FEEDBACK_MEDIA=data/feedback_media
# GATEWAY_SESSIONS=data/sessions.json            # 登录会话（只存 token 的 sha256）
# GATEWAY_VIDEO_OWNERS=data/video_owners.json    # 视频任务归属（轮询判权用）
# GATEWAY_ENV_FILE=data/.env                     # 配置页「环境变量」那张卡写哪个文件
