# API Gateway 环境变量模板
# 复制为 .env 并填入真实 token（本机使用即可；如需版本管理，建议自行把 .env 加进 .gitignore）
# 真实环境变量优先级高于 .env（load_dotenv override=False）

AGNES_API_KEY=
B_AI_API_KEY=
VOLC_API_KEY=

# 运行参数（可选，覆盖 yaml）
# GATEWAY_CONFIG=/path/to/gateway.yaml
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=8808
# GATEWAY_GRACEFUL_SHUTDOWN=30
